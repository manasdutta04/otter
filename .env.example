# =============================================================================
# Otter — contributor / developer mode
# =============================================================================
# Copy this file to `.env` after cloning. Do not commit `.env`.
#
# End users (Docker Hub / npm CLI) do not need this file.
# Contributors use it for local API, web, and optional GitHub Connect.
# =============================================================================

# -----------------------------------------------------------------------------
# Local app URLs (defaults are fine for contributor mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Models (Ollama on the host)
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Used when the API runs inside Docker and talks to host Ollama:
PLATFORM_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_FREE_FAILOVER=true

# -----------------------------------------------------------------------------
# Datastores
# Native (no Docker): uncomment and use local Postgres/Redis.
# Docker contributor stack (compose.dev.yml): services provide these for you.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://otter:otter@127.0.0.1:5432/otter
# REDIS_URL=redis://127.0.0.1:6379/0
# REPOSITORY_DATA_DIR=./data/repositories

# -----------------------------------------------------------------------------
# GitHub Connect (optional in contributor mode)
# -----------------------------------------------------------------------------
# Preferred: use the public Otter auth broker (no Client Secret on your machine).
OTTER_AUTH_BROKER_URL=https://otter-auth-broker.manasdutta512.workers.dev
# Leave empty unless you operate your own broker and set the matching Worker secret.
OTTER_AUTH_REDEEM_SECRET=

# Legacy local OAuth (only if you are not using the broker):
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
OTTER_INTERNAL_TOKEN=
