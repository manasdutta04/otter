# =============================================================================
# Otter environment
# Copy to `.env` and fill GitHub OAuth values.
# =============================================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
OTTER_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# Platform (Docker self-host) — used by docker/compose.platform.yml
# Browser opens http://127.0.0.1:3000 ; API on http://127.0.0.1:8000
# Ollama runs on the host (not inside the image).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_URL=http://127.0.0.1:3000
# Marketing/docs site (Vercel). Product UI links "Docs" here.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
# Inside Compose these are overridden to postgres/redis service DNS:
# DATABASE_URL=postgresql+asyncpg://otter:otter@postgres:5432/otter
# REDIS_URL=redis://redis:6379/0
# REPOSITORY_DATA_DIR=/data/repositories
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b
# Native: http://127.0.0.1:11434/v1
# Platform Compose ignores this and uses PLATFORM_LLM_BASE_URL (host.docker.internal).
LLM_BASE_URL=http://127.0.0.1:11434/v1
PLATFORM_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_FREE_FAILOVER=true

# -----------------------------------------------------------------------------
# Native local run (no Docker) — override when using scripts/dev-native.ps1
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://otter:otter@127.0.0.1:5432/otter
# REDIS_URL=redis://127.0.0.1:6379/0
# REPOSITORY_DATA_DIR=./data/repositories
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_URL=http://localhost:3000
