{
  "name": "otter",
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker/compose.yml up",
    "dev:build": "docker compose -f docker/compose.yml up --build",
    "web": "npm --prefix apps/web run dev",
    "api": "python -m uvicorn app.main:app --reload --app-dir apps/api",
    "cli": "npm --prefix apps/cli run build",
    "docker:clean": "docker system prune -f"
  }
}
